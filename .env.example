# Copy to .env and adjust. Never commit .env.

# Database: SQLite (default, zero setup) ...
PEOPLELENS_DATABASE_URL=sqlite:///data/peoplelens.db
# ... or PostgreSQL (docker compose up -d db)
# PEOPLELENS_DATABASE_URL=postgresql+psycopg://peoplelens:change-me@localhost:5432/peoplelens

# PostgreSQL read-only roles (created by the pipeline when the passwords are set)
# PEOPLELENS_ANALYST_PASSWORD=change-me-analyst
# PEOPLELENS_VIEWER_PASSWORD=change-me-viewer
# PEOPLELENS_ANALYST_DATABASE_URL=postgresql+psycopg://peoplelens_analyst_ro:change-me-analyst@localhost:5432/peoplelens
# PEOPLELENS_VIEWER_DATABASE_URL=postgresql+psycopg://peoplelens_viewer:change-me-viewer@localhost:5432/peoplelens

# Data profile: full (~9.3k employees, ~545k source rows) or dev (~1k employees, fast)
PEOPLELENS_PROFILE=full
# Build the database automatically on first app launch if it is missing (useful on free hosting)
PEOPLELENS_AUTO_BOOTSTRAP=true
